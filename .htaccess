RewriteEngine On

# Solo se puede acceder a la landing, a los recursos del front (css, js, assets, paginas) y a la API;
# cualquier otra cosa (docs, .env, docker-compose.yml, .git, etc.) responde 404.
RewriteCond %{REQUEST_URI} !^/(index\.html)?$
RewriteCond %{REQUEST_URI} !^/(api|css|js|assets|paginas)(/|$)
RewriteRule ^ - [R=404,L]
